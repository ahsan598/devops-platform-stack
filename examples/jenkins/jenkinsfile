pipeline {
    agent any

    // Define the required tools for the pipeline
    tools {
        jdk 'jdk21'
        maven 'maven3'
    }

    // Define environment variables for the pipeline
    environment {

        // Application & Git Configuration
        APP_NAME         = 'your-app-name'
        GIT_URL          = 'https://github.com/your-org/your-repo-name.git'
        GIT_BRANCH       = 'main'
        GIT_CREDENTIAL_ID = 'github-token'

        // Container Registry & Kubernetes Configuration
        IMAGE_NAME       = 'your_dockerhub_username/your-app-name'
        APP_NAMESPACE    = 'your-app-namespace'
        K8S_MANIFEST     = 'k8s/deployment.yaml'
        K8S_CREDENTIAL_ID = 'k8s-cred'
        K8S_SERVER_URL   = 'https://<your-cluster-ip>:6443'
        
        // Tools & Plugin Configuration
        SONAR_SERVER     = 'sonar-server'
        MAVEN_SETTINGS   = 'global-maven'
        DOCKER_CRED_ID   = 'docker-cred'
        DEPENDENCY_CHECK = 'DP-Check'
    }

    // Define options for the pipeline
    options {
        timeout(time: 10, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '5'))
        disableConcurrentBuilds()
    }

    // Define the stages of the pipeline
    stages {

        // 1. Checkout Source Code from Git Repository
        stage('Git Checkout') { 
            steps {
                git branch: "${env.GIT_BRANCH}", 
                    url: "${env.GIT_URL}",
                    credentialsId: "${env.GIT_CREDENTIAL_ID}"
            }
        }

        // 2.  Code Compilation & Unit Testing (Skipping Tests for Faster Build)
        stage('Code Compile & Test') {
            steps {
                sh "mvn clean test -DskipTests=true"
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        // 3. Static Code Analysis with SonarQube
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${env.SONAR_SERVER}") {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        // if you want to use the Sonar Maven plugin directly, you can replace the above
        // stage('SonarQube Analysis') {
        //     steps {
        //         withSonarQubeEnv("${env.SONAR_SERVER}") {
        //             sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
        //         }
        //     }
        // }

        // 4. Quality Gate Check (Fail the Build if Quality Gate Fails)
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // 5. OWASP Dependency Check for Vulnerability Scanning
        stage('OWASP Dependency Check') {
            steps {
                dependencyCheck additionalArguments: '--scan ./ --format HTML --out dependency-check-report.html --noupdate', 
                                odcInstallation: "${env.DEPENDENCY_CHECK}"
            }
        }

        // 6. Build Package Artifact (.jar / .war)
        stage('Build Artifact') {
            steps {
                sh "mvn package -DskipTests=true"
            }
        }

        // 7. Publish Artifact to Repository (e.g., Nexus / Artifactory)
        stage('Publish Artifact') {
            steps {
                withMaven(globalMavenSettingsConfig: "${env.MAVEN_SETTINGS}", traceability: true) {
                    sh "mvn clean deploy -DskipTests=true"
                }
            }
        }

        // If you want to use credentials for publishing to Nexus, you can uncomment the following stage
        // stage('Build & Push Artifact') {
        //     steps {
        //         withCredentials([usernamePassword(credentialsId: 'nexus-cred', passwordVariable: 'NEXUS_PASSWORD', usernameVariable: 'NEXUS_USERNAME')]) {
        //             withMaven(globalMavenSettingsConfig: "${env.MAVEN_SETTINGS}", traceability: true) {
        //                 sh "mvn clean deploy -DskipTests=true"
        //             }
        //         }
        //     }
        // }

        // 8. Containerization & Vulnerability Scanning (Docker & Trivy)
        stage('Docker Build & Scan') {
            steps {
                script {
                    sh "docker build -t ${env.IMAGE_NAME}:${BUILD_NUMBER} -f Dockerfile ."
                    sh "trivy image --format table -o trivy-image-report.html ${env.IMAGE_NAME}:${BUILD_NUMBER}"
                }
            }
        }

        // 9. Push Docker Image to Container Registry (e.g., DockerHub / ECR / GCR)
        stage('Push Image to Registry') {
            steps {
                script {
                    withDockerRegistry(credentialsId: "${env.DOCKER_CRED_ID}") {
                        sh "docker push ${env.IMAGE_NAME}:${BUILD_NUMBER}"
                    }
                }
            }
        }

        // 10. Kubernetes Deployment (Dynamic Image Tag Update in Manifest)
        stage('Kubernetes Deploy') {
            steps {
                script {
                    echo "Deploying image ${env.IMAGE_NAME}:${BUILD_NUMBER} to namespace: ${env.APP_NAMESPACE}"
                    sh """
                        # Dynamically update the image tag in the deployment manifest
                        sed -i -E "s|image:.*|image: ${env.IMAGE_NAME}:${BUILD_NUMBER}|g" ${env.K8S_MANIFEST}
                        
                        # Apply Kubernetes configuration
                        kubectl apply -f ${env.K8S_MANIFEST} -n ${env.APP_NAMESPACE}
                        
                        # Verify deployment rollout success
                        kubectl rollout status deployment/${env.APP_NAME} -n ${env.APP_NAMESPACE} --timeout=120s
                    """
                }
            }
        }

        // 11. Verify the Deployment (Check Pods & Services in Kubernetes Namespace)
        stage('Verify the Deployment') {
            steps {
                withKubeConfig(caCertificate: '', clusterName: 'kubernetes', contextName: '', credentialsId: "${env.K8S_CREDENTIAL_ID}", namespace: "${env.APP_NAMESPACE}", restrictKubeConfigAccess: false, serverUrl: "${env.K8S_SERVER_URL}") {
                    sh "kubectl get pods -n ${env.APP_NAMESPACE}"
                    sh "kubectl get svc -n ${env.APP_NAMESPACE}"
                }
            }
        }
    }

    // Define post-build actions for the pipeline
    post {

        // Always execute these steps regardless of build success or failure
        always {

            // Archive Trivy Security Scan Report
            echo 'Archiving Trivy Security Scan Report...'
            archiveArtifacts artifacts: '**/dependency-check-report.html', allowEmptyArchive: true
            
            // Clean up local Docker images to free up space
            echo 'Cleaning up local Docker images...'
            sh "docker rmi ${env.IMAGE_NAME}:${BUILD_NUMBER} || true"

            cleanWs()
        }
        
        // Execute these steps only if the build is successful
        success {
            echo "Build #${BUILD_NUMBER} deployed successfully to Kubernetes namespace '${env.APP_NAMESPACE}'!"
        }
        
        // Execute these steps only if the build fails
        failure {
            echo "Build #${BUILD_NUMBER} Failed during build or Kubernetes deployment!"
        }
    }
}
