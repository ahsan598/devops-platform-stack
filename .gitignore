# ==========================================
# DevOps Platform Stack - Master .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secrets (CRITICAL)
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx

# ------------------------------------------
# Kubernetes & Cluster State
# ------------------------------------------
*kubeconfig*
*.kubeconfig
kubeconfig.yaml
jenkins-kubeconfig
.helm/
*.tgz

# ------------------------------------------
# Local Service Mounts & Persistent Data
# ------------------------------------------
*_data/
*_logs/
jenkins_home/
sonar_data/
sonar_extensions/
sonar_logs/
nexus_data/
postgresql_data/
*.sock

# ------------------------------------------
# Node.js & Application Dependencies
# ------------------------------------------
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------
# Terraform State & Crash Logs
# ------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log

# ------------------------------------------
# OS & IDE Files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# VS Code & JetBrains
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.iws
*.iml
*.ipr

# ------------------------------------------
# Logs & Temporary Files
# ------------------------------------------
*.log
*.tmp
*.bak
*.swp
*~