pipeline {
    agent any
    stages {
        stage('Build Frontend') {
            steps {
                // Jenkins container ke andar Node.js hone ki zaroorat nahi hai
                // Ye temporary node:20-alpine container me run hoga
                sh 'docker run --rm -v $PWD:/app -w /app node:20-alpine npm install && npm run build'
            }
        }
        stage('Python Tests') {
            steps {
                // Similarly for Python
                sh 'docker run --rm -v $PWD:/app -w /app python:3.11-slim pytest'
            }
        }
    }
}