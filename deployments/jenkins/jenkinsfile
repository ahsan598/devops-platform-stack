pipeline {
    agent any

    tools {
        jdk 'jdk21'
        maven 'maven3'
    }

    environment {
        IMAGE_NAME    = 'username/myapp' // Replace with your actual Docker Hub username/app
        GITOPS_REPO   = 'https://github.com/repo/gitops-manifests.git'
        APP_NAMESPACE = 'webapps'
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '5'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout Source') { 
            steps {
                cleanWs()
                git branch: 'main', 
                    url: 'https://github.com/repo/repo_name.git',
                    credentialsId: 'github-token'
            }
        }

        stage('Code Compile & Test') {
            steps {
                sh "mvn clean test"
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                // FIXED: Matched UI server name 'sonar-server' & Maven scanner plugin call
                withSonarQubeEnv('sonar-server') {
                    sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Pipeline aborted: Quality Gate failed with status [${qg.status}]"
                        } else {
                            echo "Quality Gate Passed Successfully!"
                        }
                    }
                }
            }
        }

        stage('OWASP Security Scan') {
            steps {
                // Keep --noupdate flag active if NVD download is too slow
                dependencyCheck additionalArguments: '--scan ./ --format HTML --out dependency-check-report.html --noupdate', 
                                odcInstallation: 'DP-Check'
            }
        }

        stage('Build & Push Artifact') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-cred', passwordVariable: 'NEXUS_PASSWORD', usernameVariable: 'NEXUS_USERNAME')]) {
                    withMaven(globalMavenSettingsConfig: 'global-maven', traceability: true) {
                        sh 'mvn clean deploy -DskipTests=true -Dnexus.username=$NEXUS_USERNAME -Dnexus.password=$NEXUS_PASSWORD'
                    }
                }
            }
        }

        stage('Docker Build & Trivy Scan') {
            steps {
                script {
                    // FIXED: Pointing directly to root Dockerfile
                    sh "docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} -f Dockerfile ."
                    
                    // Security Scan via Trivy
                    sh "trivy image --severity HIGH,CRITICAL --exit-code 0 ${IMAGE_NAME}:${BUILD_NUMBER}"
                }
            }
        }

        stage('Push Image to Registry') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred') {
                        sh "docker push ${IMAGE_NAME}:${BUILD_NUMBER}"
                    }
                }
            }
        }

        stage('GitOps Deployment Update') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-token', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
                    sh """
                        git config --global user.email "jenkins@devops-workbench.local"
                        git config --global user.name "Jenkins CI"
                        
                        # FIXED: Remove existing directory before fresh clone
                        rm -rf gitops-repo
                        git clone ${GITOPS_REPO} gitops-repo
                        cd gitops-repo

                        # Dynamic update in deployment manifest
                        sed -i 's|image: ${IMAGE_NAME}:.*|image: ${IMAGE_NAME}:${BUILD_NUMBER}|g' manifest/deployment.yaml
                        
                        git add manifest/deployment.yaml
                        git commit -m "chore(ci): update image tag to ${BUILD_NUMBER} [skip ci]" || echo "No changes to commit"
                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/repo/gitops-manifests.git HEAD:main
                    """
                }
            }
        }
    }

    post {
        always {
            echo 'Archiving Security & Coverage Reports...'
            archiveArtifacts artifacts: '**/dependency-check-report.html', allowEmptyArchive: true
            cleanWs()
        }
        
        success {
            echo "Build #${BUILD_NUMBER} completed successfully!"
        }

        failure {
            echo "Build #${BUILD_NUMBER} Failed!"
        }
    }
}
