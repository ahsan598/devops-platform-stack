pipeline {
    agent any

    tools {
        jdk 'jdk21'
        maven 'maven3'
    }

    environment {
        IMAGE_NAME   = 'ahsan98/spring-petclinic'
        // GITOPS_REPO   = 'https://github.com/ahsan598/spring-petclinic.git'
        APP_NAMESPACE = 'webapps'
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '5'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout Source') { 
            steps {
                cleanWs()
                git branch: 'main', url: 'https://github.com/ahsan598/spring-petclinic.git'
            }
        }

        stage('Code Compile & Test') {
            steps {
                sh "mvn clean test -DskipTests=true"
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                }
            }
        }

        // stage('SonarQube Analysis') {
        //     steps {
        //         withSonarQubeEnv('sonar-server') {
        //             sh 'mvn sonar:sonar'
        //         }
        //     }
        // }

        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dependencyCheck additionalArguments: '--scan ./ --format HTML --out dependency-check-report.html --noupdate', 
                                odcInstallation: 'DP-Check'
            }
        }

        stage('Build & Push Artifact') {
            steps {
                withMaven(globalMavenSettingsConfig: 'global-maven', traceability: true) {
                    sh "mvn clean deploy -DskipTests=true"
                }
            }
        }

        // stage('Build & Push Artifact') {
        //     steps {
        //         withCredentials([usernamePassword(credentialsId: 'nexus-cred', passwordVariable: 'NEXUS_PASSWORD', usernameVariable: 'NEXUS_USERNAME')]) {
        //             withMaven(globalMavenSettingsConfig: 'global-maven', traceability: true) {
        //                 sh "mvn clean deploy -DskipTests=true"
        //             }
        //         }
        //     }
        // }
        
        stage('Docker Build & Trivy Scan') {
            steps {
                script {
                    sh "docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} -f Dockerfile ."
                    sh "trivy image --format table -o trivy-image-report.html ${IMAGE_NAME}:${BUILD_NUMBER}"
                }
            }
        }

        stage('Push Image to Registry') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred') {
                        sh "docker push ${IMAGE_NAME}:${BUILD_NUMBER}"
                    }
                }
            }
        }

        stage('Kubernetes Deploy') {
            steps {
                script {
                    echo "Deploying image ${IMAGE_NAME}:${BUILD_NUMBER} directly to Kubernetes namespace: ${APP_NAMESPACE}"
                    sh """
                        # Update manifest dynamically or apply manifest file
                        sed -i -E "s|image:.*|image: ${IMAGE_NAME}:${BUILD_NUMBER}|g" k8s/petclinic.yaml
                        kubectl apply -f k8s/petclinic.yaml -n ${APP_NAMESPACE}
                        
                        # Trigger rollout status check to verify deployment success
                        kubectl rollout status deployment/petclinic -n ${APP_NAMESPACE} --timeout=120s
                    """
                }
            }
        }

        // stage('GitOps Deployment Update') {
        //     environment {
        //         GITOPS_REPO = 'https://github.com/ahsan598/spring-petclinic.git'
        //         IMAGE_NAME  = 'ahsan98/spring-petclinic'
        //         GIT_USER    = 'Jenkins CI'
        //         GIT_EMAIL   = 'jenkins@devops-workbench.local'
        //     }
        //     steps {
        //         withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
        //             sh '''
        //                 git config --global user.email "${GIT_EMAIL}"
        //                 git config --global user.name "${GIT_USER}"
                        
        //                 rm -rf gitops-repo
        //                 git clone https://${GITHUB_TOKEN}@github.com/ahsan598/spring-petclinic.git gitops-repo
        //                 cd gitops-repo

        //                 echo "=== Before SED ==="
        //                 grep -i "image:" k8s/petclinic.yaml || true

        //                 # Fixed SED Command without syntax escaping issues
        //                 sed -i -E "s|image:.*|image: ahsan98/spring-petclinic:${BUILD_NUMBER}|g" k8s/petclinic.yaml

        //                 echo "=== After SED ==="
        //                 grep -i "image:"k8s/petclinic.yaml || true

        //                 git add k8s/petclinic.yaml
        //                 git commit -m "update image tag to ahsan98/spring-petclinic:${BUILD_NUMBER}" || echo "No changes to commit"
                        
        //                 git push https://${GITHUB_TOKEN}@github.com/ahsan598/spring-petclinic.git HEAD:main
        //             '''
        //         }
        //     }
        // }
    }

    post {
        always {
            echo 'Archiving Security & Coverage Reports...'
            archiveArtifacts artifacts: '**/dependency-check-report.html', allowEmptyArchive: true
            
            // Local Docker Image Cleanup
            echo 'Cleaning up built Docker image from local agent...'
            sh "docker rmi ${IMAGE_NAME}:${BUILD_NUMBER} || true"

            cleanWs()
        }
        
        success {
            echo "Build #${BUILD_NUMBER} deployed successfully to Kubernetes namespace '${APP_NAMESPACE}'!"
        }

        failure {
            echo "Build #${BUILD_NUMBER} Failed during build or Kubernetes deployment!"
        }
    }
}
